# =====================================================================
# Nexora — environment variable template
#
# HOW TO USE
#   1. Copy this file to `.env` in the same directory:
#          cp .env.example .env        (Git Bash)
#          Copy-Item .env.example .env (PowerShell)
#   2. Fill in the real values below.
#   3. NEVER commit `.env`. It is already excluded by .gitignore
#      (.env, .env.*, *.env).
#   4. Placeholders in this template must stay fake. Do not put real
#      passwords, tokens or signing keys into any tracked file.
#
# Spring Boot does NOT read `.env` automatically. There is no dotenv
# dependency in pom.xml and no spring.config.import, so the file is inert
# until you export it into the shell (or IDE run configuration) that
# launches the application.
#
#   Git Bash:
#       set -a; source .env; set +a
#       ./mvnw.cmd spring-boot:run
#
#   Windows PowerShell:
#       Get-Content .env | ForEach-Object {
#         if ($_ -match '^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$') {
#           [Environment]::SetEnvironmentVariable(
#             $Matches[1], $Matches[2].Trim().Trim('"'), 'Process')
#         }
#       }
#       .\mvnw.cmd spring-boot:run
#
#   Confirm the JVM will actually see them (prints presence, never values):
#       Git Bash     env | grep -oE '^(DB_|NEXORA_|SERVER_)[A-Z_]*'
#       PowerShell   'DB_URL','DB_USERNAME','DB_PASSWORD' | ForEach-Object {
#                      "$_ set = $([bool][Environment]::GetEnvironmentVariable($_))" }
#
# Both snippets set variables for the current session only, so the password
# never reaches the registry or your shell history file.
# =====================================================================


# ---------------------------------------------------------------------
# BACKEND — MySQL datasource
#
# DB_USERNAME and DB_PASSWORD are MANDATORY. Neither has a default, and
# DataSourceConfigValidator refuses to start the application without them
# rather than letting Hibernate fail later with a misleading
# "Access denied ... (using password: YES)".
#
# DB_URL and DB_DRIVER already default to a local MySQL "nexora" schema
# (jdbc:mysql://localhost:3306/nexora and com.mysql.cj.jdbc.Driver), so you
# only need to set them if your host, port or schema name differs.
#
# There is deliberately no in-memory H2 fallback in the default profile.
# It used to fall back silently and discard every write on shutdown.
# To run without MySQL at all, use the opt-in H2 profile instead:
#     SPRING_PROFILES_ACTIVE=h2
# ---------------------------------------------------------------------

# The `nexora` schema must already exist. Create it once, manually:
#     CREATE DATABASE nexora CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Do NOT append createDatabaseIfNotExist=true — the backend should never
# create or alter a database it was not explicitly pointed at.
#
# useSSL=false / allowPublicKeyRetrieval=true are LOCAL DEVELOPMENT ONLY.
# allowPublicKeyRetrieval exposes the connection to MITM on untrusted
# networks; use TLS instead in any shared or production environment.
DB_URL="jdbc:mysql://localhost:3306/nexora?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
DB_USERNAME="YOUR_MYSQL_USERNAME"
DB_PASSWORD="YOUR_MYSQL_PASSWORD"
DB_DRIVER="com.mysql.cj.jdbc.Driver"

# Optional backend tuning — all have working defaults, safe to leave unset.
# SERVER_PORT="8080"
# DB_DDL_AUTO="update"                 # switch to "validate" once Flyway owns the schema
# DB_SHOW_SQL="false"
# DB_POOL_MAX_SIZE="10"
# DB_POOL_MIN_IDLE="2"
# DB_POOL_CONNECTION_TIMEOUT_MS="30000"
# DB_POOL_IDLE_TIMEOUT_MS="600000"
# DB_POOL_MAX_LIFETIME_MS="1800000"
# DB_POOL_VALIDATION_TIMEOUT_MS="5000"

# ---------------------------------------------------------------------
# BACKEND — bootstrap administrator
#
# DataInitializer creates this account on first launch if no employee with
# the given email exists, and skips creation otherwise (idempotent).
#
# The defaults compiled into application.properties are PUBLIC — they are
# committed to this repository and must be treated as compromised. Override
# both values here for any database that is not a throwaway local one.
# ---------------------------------------------------------------------
# NEXORA_BOOTSTRAP_ADMIN_EMAIL="admin@nexora.com"
# NEXORA_BOOTSTRAP_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD"
# NEXORA_BOOTSTRAP_ADMIN_NAME="Nexora System Admin"

# Set to false to start against an existing database WITHOUT inserting the
# demo dataset (employees, projects, tasks, meetings, messages, resources).
# DataInitializer seeds that dataset whenever the employee table holds one
# row or fewer, i.e. on every fresh schema.
# NEXORA_BOOTSTRAP_ENABLED="true"

# ---------------------------------------------------------------------
# BACKEND — JWT signing
#
# The default in application.properties is PUBLIC and committed to git.
# Anyone with read access to this repo can forge a valid ADMIN token for a
# deployment that does not override it. Set a unique random value of at
# least 64 characters, for example:
#     openssl rand -base64 64
# Rotating this value invalidates every previously issued token.
# ---------------------------------------------------------------------
# NEXORA_JWT_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_64+_CHARACTER_SECRET"
# NEXORA_JWT_EXPIRATION_MS="86400000"


# ---------------------------------------------------------------------
# FRONTEND — AI Studio / Vite (pre-existing entries, unchanged)
# ---------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Spring Boot REST API Base URL (Frontend integration ready)
VITE_API_BASE_URL="http://localhost:8080/api"
